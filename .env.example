# --- LINE Messaging API（LINE Developers Console > Messaging API 分頁）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Claude API ---
ANTHROPIC_API_KEY=
# 模型與思考深度（low / medium / high）。現場要快可用 low，判斷要細可用 high
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- 知識來源 ---
FAQ_PATH=config/faq.yaml
PLAYBOOK_PATH=config/playbook.yaml
# 選填：若 FAQ 放在 Google 試算表，「檔案 > 共用 > 發布到網路 > CSV」貼上網址即可（優先於 FAQ_PATH）
# 欄位需為：id, category, question, answer, keywords
FAQ_SHEET_CSV_URL=
FAQ_SHEET_TTL_SECONDS=300

# --- 權限 ---
# 允許使用的工作人員 LINE userId，逗號分隔；留空 = 所有加好友的人都能用
ALLOWED_USER_IDS=
# 可下「/reload」指令的管理員 userId
ADMIN_USER_IDS=
# 群組中需要以此開頭才會回應（1 對 1 聊天不需要）
GROUP_TRIGGER=?

# 每位使用者保留的對話輪數（讓追問能接續上下文）
HISTORY_TURNS=6
